<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application>

        <service
            android:name=".projection.MediaProjectionService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Mantiene activa la captura de pantalla que SIRC analiza localmente para calcular la rentabilidad de una oferta. El contenido nunca sale del dispositivo." />
        </service>

    </application>
</manifest>
